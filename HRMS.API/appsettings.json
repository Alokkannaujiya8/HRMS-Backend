{
  "ConnectionStrings": {
    "DefaultConnection": "server=ALOK\\SQLEXPRESS02;Database=HRMSDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/hrms-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "server=ALOK\\SQLEXPRESS02;Database=HRMSDB;Trusted_Connection=True;TrustServerCertificate=True",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlTable": true
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "Jwt": {
    "Key": "THIS_IS_A_VERY_SECURE_SECRET_KEY_1234567890",
    "Issuer": "HRMSAPI",
    "Audience": "HRMSUSER",
    "DurationInMinutes": 120
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "yourgmail@gmail.com",
    "Password": "your-app-password"
  },
  "Hangfire": {
    "TimeZoneId": "India Standard Time",
    "Dashboard": {
      "Username": "admin",
      "Password": "change-this-password"
    }
  },
  "AllowedHosts": "*"
}
